# AI Governance & Risk Auditor - Environment Configurations

# Google Gemini Configuration
# Provide your Gemini API key to run queries against active live models.
# Obtain a key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# Local Ollama Configuration
# Ensure your local Ollama node is running and models are downloaded.
# Standard local URL is: http://localhost:11434
# Important CORS config: set OLLAMA_ORIGINS="*" before starting Ollama service.
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3
